WITH daily AS (
  SELECT dc_id,
         assoc_id,
         assoc_name,
         supv_name,
         week_end_date,
         date_dt,
         SUM(act_work_min)                              AS act_min,
         SUM(std_tot_min)                               AS std_min,
         100 * SUM(std_tot_min) / NULLIF(SUM(act_work_min), 0) AS perf_pct
  FROM   exceed.crr_perf_v
  WHERE  jobcode_on_standard_flg = 'Y'
    AND  assoc_id IS NOT NULL
    AND  date_dt >= DATE '2026-11-01'
  GROUP  BY dc_id, assoc_id, assoc_name, supv_name, week_end_date, date_dt
  HAVING SUM(act_work_min) >= 120
)
SELECT dc_id,
       assoc_id,
       assoc_name,
       supv_name,
       week_end_date,
       COUNT(*)                               AS days_worked,
       ROUND(100 * SUM(std_min) / SUM(act_min), 1) AS week_perf_pct,
       ROUND(MIN(perf_pct), 1)                AS worst_day_pct,
       ROUND(MAX(perf_pct), 1)                AS best_day_pct,
       ROUND(MAX(perf_pct) - MIN(perf_pct), 1) AS range_pts,
       ROUND(STDDEV(perf_pct), 1)             AS stddev_pts
FROM   daily
GROUP  BY dc_id, assoc_id, assoc_name, supv_name, week_end_date
HAVING COUNT(*) >= 3
ORDER  BY stddev_pts DESC;
